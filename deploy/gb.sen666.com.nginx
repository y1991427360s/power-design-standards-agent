# 本站使用 DNS-only + Let's Encrypt TLS；不改变其他域名的 Cloudflare SSL 设置。
limit_req_zone $binary_remote_addr zone=gb_login:10m rate=5r/m;
server {
    listen 80;
    listen [::]:80;
    server_name gb.sen666.com;
    return 301 https://gb.sen666.com$request_uri;
}
server {
    listen 127.0.0.1:9530 ssl;
    server_name gb.sen666.com;
    ssl_certificate /etc/letsencrypt/live/gb.sen666.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gb.sen666.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 51m;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    location = /api/login {
        limit_req zone=gb_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8030;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / {
        proxy_pass http://127.0.0.1:8030;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 300s;
    }
}
