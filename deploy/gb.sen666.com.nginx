# 本站使用 DNS-only + Let's Encrypt TLS；不改变其他域名的 Cloudflare SSL 设置。
server {
    listen 80;
    listen [::]:80;
    server_name gb.sen666.com;
    return 301 https://gb.sen666.com$request_uri;
}
server {
    listen 127.0.0.1:9530 ssl;
    server_name gb.sen666.com;
    ssl_certificate /etc/letsencrypt/live/gb.sen666.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gb.sen666.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    auth_basic "Power Standards";
    auth_basic_user_file /etc/nginx/gb.htpasswd;
    client_max_body_size 51m;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    location / {
        proxy_pass http://127.0.0.1:8030;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 300s;
    }
}
